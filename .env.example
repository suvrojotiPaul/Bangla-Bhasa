# Copy this file to .env and edit. Paths are relative to the project folder.
# Keep comments on their own lines: text after a value is read as part of it.

PORT=3000
# 127.0.0.1 = this computer only. Set 0.0.0.0 to open the app from your phone on the same Wi-Fi.
HOST=127.0.0.1

DB_PATH=./data/bhasha.sqlite
# The course: a folder with course.json and one file per unit.
CURRICULUM_PATH=./data/course

# The admin account. It can see everyone's progress and time spent, set new passwords and
# remove accounts. Created on start if it doesn't exist; the password here always wins, so
# change it here (and restart) rather than in the app. Everyone else signs up in the app.
ADMIN_USERNAME=
ADMIN_PASSWORD=
