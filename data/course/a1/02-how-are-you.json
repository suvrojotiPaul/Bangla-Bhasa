        "ধন্যবাদ": { "ro": "dhonnobad", "en": "Thank you", "fr": "Merci", "pos": "intj", "note": "Said for real favours. Family and friends often don't say it, and that isn't rude." },
        "আছে": { "ro": "achhe", "en": "Is; there is, has", "fr": "Est, va ; il y a", "pos": "verb", "note": "Also how Bengali says \"have\": আমার বই আছে = I have a book (literally: my book is there)." },
