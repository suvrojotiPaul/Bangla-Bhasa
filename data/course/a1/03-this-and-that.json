      "sentences": [
        { "bn": "এটা কী?", "ro": "eta ki?", "en": "What is this?", "fr": "Qu'est-ce que c'est ?" },
        { "bn": "এটা বই।", "ro": "eta boi.", "en": "This is a book.", "fr": "C'est un livre." },
        { "bn": "এটা আমার বই।", "ro": "eta amar boi.", "en": "This is my book.", "fr": "C'est mon livre." },
        { "bn": "এটা কলম।", "ro": "eta kolom.", "en": "This is a pen.", "fr": "C'est un stylo." },
        { "bn": "আপনার কলম।", "ro": "apnar kolom.", "en": "Your pen.", "fr": "Votre stylo." },
        { "bn": "এটা তোমার ফোন?", "ro": "eta tomar fon?", "en": "Is this your phone?", "fr": "C'est ton téléphone ?" },
        { "bn": "না, এটা আমার ফোন।", "ro": "na, eta amar fon.", "en": "No, this is my phone.", "fr": "Non, c'est mon téléphone." },

        { "bn": "ওটা কী?", "ro": "ota ki?", "en": "What is that?", "fr": "C'est quoi, ça ?" },
        { "bn": "ওটা আমার ব্যাগ।", "ro": "ota amar byag.", "en": "That's my bag.", "fr": "C'est mon sac." },
        { "bn": "ওটা তোমার ব্যাগ?", "ro": "ota tomar byag?", "en": "Is that your bag?", "fr": "C'est ton sac, ça ?" },
        { "bn": "এটা আমার চাবি।", "ro": "eta amar chabi.", "en": "This is my key.", "fr": "C'est ma clé." },
        { "bn": "তোমার চাবি আছে?", "ro": "tomar chabi achhe?", "en": "Do you have your key?", "fr": "Tu as ta clé ?" },
        { "bn": "ওটা আমার ছাতা।", "ro": "ota amar chhata.", "en": "That's my umbrella.", "fr": "C'est mon parapluie." },
        { "bn": "আপনার ছাতা আছে?", "ro": "apnar chhata achhe?", "en": "Do you have an umbrella?", "fr": "Vous avez un parapluie ?" },

        { "bn": "এটা কি তোমার ফোন?", "ro": "eta ki tomar fon?", "en": "Is this your phone?", "fr": "Est-ce que c'est ton téléphone ?" },
        { "bn": "ওটা কি আপনার ব্যাগ?", "ro": "ota ki apnar byag?", "en": "Is that your bag?", "fr": "Est-ce que c'est votre sac ?" },
        { "bn": "এটা কার বই?", "ro": "eta kar boi?", "en": "Whose book is this?", "fr": "À qui est ce livre ?" },
        { "bn": "ওটা কার ছাতা?", "ro": "ota kar chhata?", "en": "Whose umbrella is that?", "fr": "À qui est ce parapluie ?" },
        { "bn": "এই বইটা আমার।", "ro": "ei boita amar.", "en": "This book is mine.", "fr": "Ce livre est à moi." },
        { "bn": "এই চাবিটা কার?", "ro": "ei chabita kar?", "en": "Whose key is this?", "fr": "À qui est cette clé ?" },
        { "bn": "ওই ব্যাগটা আমার।", "ro": "oi byagta amar.", "en": "That bag is mine.", "fr": "Ce sac-là est à moi." },
        { "bn": "ওই কলমটা কি তোমার?", "ro": "oi kolomta ki tomar?", "en": "Is that pen yours?", "fr": "Ce stylo-là, il est à toi ?" }
