      "sentences": [
        { "bn": "ইনি আমার মা।", "ro": "ini amar ma.", "en": "This is my mother.", "fr": "Voici ma mère." },
        { "bn": "ইনি আমার বাবা।", "ro": "ini amar baba.", "en": "This is my father.", "fr": "Voici mon père." },
        { "bn": "মা কেমন আছেন?", "ro": "ma kemon achhen?", "en": "How is your mother?", "fr": "Comment va ta mère ?" },
        { "bn": "বাবা ভালো আছেন।", "ro": "baba bhalo achhen.", "en": "Dad is well.", "fr": "Papa va bien." },
        { "bn": "আমার পরিবার ভালো আছে।", "ro": "amar poribar bhalo achhe.", "en": "My family is well.", "fr": "Ma famille va bien." },
        { "bn": "তোমার পরিবার কেমন আছে?", "ro": "tomar poribar kemon achhe?", "en": "How is your family?", "fr": "Comment va ta famille ?" },

        { "bn": "আমার দাদা আছে।", "ro": "amar dada achhe.", "en": "I have an elder brother.", "fr": "J'ai un grand frère." },
        { "bn": "দাদা কেমন আছে?", "ro": "dada kemon achhe?", "en": "How is your big brother?", "fr": "Comment va ton grand frère ?" },
        { "bn": "আমার দিদি আছে।", "ro": "amar didi achhe.", "en": "I have an elder sister.", "fr": "J'ai une grande sœur." },
        { "bn": "দিদি ভালো আছে।", "ro": "didi bhalo achhe.", "en": "My big sister is fine.", "fr": "Ma grande sœur va bien." },
        { "bn": "তোমার ভাই আছে?", "ro": "tomar bhai achhe?", "en": "Do you have a brother?", "fr": "Tu as un frère ?" },
        { "bn": "আমার ভাই আছে।", "ro": "amar bhai achhe.", "en": "I have a younger brother.", "fr": "J'ai un petit frère." },
        { "bn": "আমার বোন আছে।", "ro": "amar bon achhe.", "en": "I have a younger sister.", "fr": "J'ai une petite sœur." },
        { "bn": "তোমার বোন কেমন আছে?", "ro": "tomar bon kemon achhe?", "en": "How is your sister?", "fr": "Comment va ta sœur ?" },

        { "bn": "এ আমার ছেলে।", "ro": "e amar chhele.", "en": "This is my son.", "fr": "Voici mon fils." },
        { "bn": "এ আমার মেয়ে।", "ro": "e amar meye.", "en": "This is my daughter.", "fr": "Voici ma fille." },
        { "bn": "এ আমার ভাই।", "ro": "e amar bhai.", "en": "This is my brother.", "fr": "Voici mon frère." },
        { "bn": "আমার ভাই নেই।", "ro": "amar bhai nei.", "en": "I don't have a brother.", "fr": "Je n'ai pas de frère." },
        { "bn": "আমার বোন নেই।", "ro": "amar bon nei.", "en": "I don't have a sister.", "fr": "Je n'ai pas de sœur." },
        { "bn": "আপনার ছেলে কেমন আছে?", "ro": "apnar chhele kemon achhe?", "en": "How is your son?", "fr": "Comment va votre fils ?" },
        { "bn": "আপনার মেয়ে ভালো আছে?", "ro": "apnar meye bhalo achhe?", "en": "Is your daughter well?", "fr": "Votre fille va bien ?" },

        { "bn": "ইনি আমার স্বামী।", "ro": "ini amar shami.", "en": "This is my husband.", "fr": "Voici mon mari." },
