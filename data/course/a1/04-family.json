        { "bn": "ইনি আমার স্ত্রী।", "ro": "ini amar stri.", "en": "This is my wife.", "fr": "Voici ma femme." },
        { "bn": "আপনার স্ত্রী কেমন আছেন?", "ro": "apnar stri kemon achhen?", "en": "How is your wife?", "fr": "Comment va votre femme ?" },
