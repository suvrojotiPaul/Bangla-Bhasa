        "কটা": { "ro": "kota", "en": "How many", "fr": "Combien", "pos": "adv", "note": "For things you count. কটা বাজে? = What time is it?" },
        "চার": { "ro": "char", "en": "Four", "fr": "Quatre", "pos": "num", "forms": {
