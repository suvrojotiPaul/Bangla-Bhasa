      "sentences": [
        { "bn": "আমি ভাত খাই।", "ro": "ami bhat khai.", "en": "I eat rice.", "fr": "Je mange du riz." },
        { "bn": "আমি মাছ খাই।", "ro": "ami machh khai.", "en": "I eat fish.", "fr": "Je mange du poisson." },
        { "bn": "আমি মাছ খাই না।", "ro": "ami machh khai na.", "en": "I don't eat fish.", "fr": "Je ne mange pas de poisson." },
        { "bn": "আমি ডাল ভাত খাই।", "ro": "ami dal bhat khai.", "en": "I eat dal and rice.", "fr": "Je mange du dal et du riz." },
        { "bn": "ডাল আর মাছ।", "ro": "dal ar machh.", "en": "Dal and fish.", "fr": "Du dal et du poisson." },

        { "bn": "তুমি কী খাও?", "ro": "tumi ki khao?", "en": "What do you eat?", "fr": "Qu'est-ce que tu manges ?" },
        { "bn": "তুমি রুটি খাও?", "ro": "tumi ruti khao?", "en": "Do you eat roti?", "fr": "Tu manges des rotis ?" },
        { "bn": "আমি রুটি খাই।", "ro": "ami ruti khai.", "en": "I eat roti.", "fr": "Je mange des rotis." },
        { "bn": "তুমি ডিম খাও?", "ro": "tumi dim khao?", "en": "Do you eat eggs?", "fr": "Tu manges des œufs ?" },
        { "bn": "আমি ডিম খাই না।", "ro": "ami dim khai na.", "en": "I don't eat eggs.", "fr": "Je ne mange pas d'œufs." },
        { "bn": "তুমি মাংস খাও না?", "ro": "tumi mangsho khao na?", "en": "Don't you eat meat?", "fr": "Tu ne manges pas de viande ?" },
        { "bn": "আমি মাংস খাই।", "ro": "ami mangsho khai.", "en": "I eat meat.", "fr": "Je mange de la viande." },

        { "bn": "আপনি কী খান?", "ro": "apni ki khan?", "en": "What do you eat?", "fr": "Qu'est-ce que vous mangez ?" },
        { "bn": "আপনি চা খান?", "ro": "apni cha khan?", "en": "Do you drink tea?", "fr": "Vous buvez du thé ?" },
        { "bn": "আমি চা খাই।", "ro": "ami cha khai.", "en": "I drink tea.", "fr": "Je bois du thé." },
        { "bn": "আমি জল খাই।", "ro": "ami jol khai.", "en": "I drink water.", "fr": "Je bois de l'eau." },
        { "bn": "আপনি জল খান?", "ro": "apni jol khan?", "en": "Do you drink water?", "fr": "Vous buvez de l'eau ?" },
        { "bn": "আপনি দুধ খান?", "ro": "apni dudh khan?", "en": "Do you drink milk?", "fr": "Vous buvez du lait ?" },
        { "bn": "আমি চা খাই, দুধ খাই না।", "ro": "ami cha khai, dudh khai na.", "en": "I drink tea, not milk.", "fr": "Je bois du thé, pas de lait." },

        { "bn": "অমিত কী খায়?", "ro": "omit ki khay?", "en": "What does Amit eat?", "fr": "Qu'est-ce que mange Amit ?" },
        { "bn": "রিয়া মাছ খায় না।", "ro": "riya machh khay na.", "en": "Riya doesn't eat fish.", "fr": "Riya ne mange pas de poisson." },
        { "bn": "আমার ভাই মিষ্টি খায়।", "ro": "amar bhai mishti khay.", "en": "My brother eats sweets.", "fr": "Mon frère mange des douceurs." },
        { "bn": "আমার বোন মিষ্টি খায় না।", "ro": "amar bon mishti khay na.", "en": "My sister doesn't eat sweets.", "fr": "Ma sœur ne mange pas de douceurs." },
        { "bn": "দিদি সবজি খায়।", "ro": "didi shobji khay.", "en": "My big sister eats vegetables.", "fr": "Ma grande sœur mange des légumes." },
        { "bn": "সবজি খুব ভালো।", "ro": "shobji khub bhalo.", "en": "Vegetables are very good.", "fr": "Les légumes, c'est très bon." }
      ]
