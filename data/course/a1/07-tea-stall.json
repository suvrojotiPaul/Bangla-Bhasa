        { "bn": "একটু জল দাও।", "ro": "ektu jol dao.", "en": "Give me a little water.", "fr": "Donne-moi un peu d'eau." },
        { "bn": "আরও একটু ভাত দাও।", "ro": "aro ektu bhat dao.", "en": "Give me a little more rice.", "fr": "Donne-moi encore un peu de riz." },
