      "sentences": [
        { "bn": "এক কাপ চা দিন।", "ro": "ek kap cha din.", "en": "A cup of tea, please.", "fr": "Un thé, s'il vous plaît." },
        { "bn": "দু কাপ চা দিন।", "ro": "du kap cha din.", "en": "Two teas, please.", "fr": "Deux thés, s'il vous plaît." },
