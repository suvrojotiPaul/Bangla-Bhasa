        { "bn": "আমি বুঝি।", "ro": "ami bujhi.", "en": "I understand.", "fr": "Je comprends." },
        { "bn": "আমি একটু বাংলা বুঝি।", "ro": "ami ektu bangla bujhi.", "en": "I understand a little Bengali.", "fr": "Je comprends un peu le bengali." },

