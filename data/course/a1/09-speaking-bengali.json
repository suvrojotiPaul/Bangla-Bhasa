      "sentences": [
        { "bn": "আমি বাংলা বলি।", "ro": "ami bangla boli.", "en": "I speak Bengali.", "fr": "Je parle bengali." },
        { "bn": "আমি একটু বাংলা বলি।", "ro": "ami ektu bangla boli.", "en": "I speak a little Bengali.", "fr": "Je parle un peu bengali." },
        { "bn": "আপনি বাংলা বলেন?", "ro": "apni bangla bolen?", "en": "Do you speak Bengali?", "fr": "Vous parlez bengali ?" },
