      "sentences": [
        { "bn": "আমি বাজারে যাব।", "ro": "ami bajare jabo.", "en": "I'll go to the market.", "fr": "J'irai au marché." },
        { "bn": "বাজার কোথায়?", "ro": "bajar kothay?", "en": "Where is the market?", "fr": "Où est le marché ?" },
        { "bn": "দাম কত?", "ro": "dam koto?", "en": "How much is it?", "fr": "C'est combien ?" },
        { "bn": "এটার দাম কত?", "ro": "etar dam koto?", "en": "How much is this?", "fr": "Combien coûte ceci ?" },
        { "bn": "আলুর দাম কত?", "ro": "alur dam koto?", "en": "How much are the potatoes?", "fr": "Combien coûtent les pommes de terre ?" },
        { "bn": "আলু কত টাকা কেজি?", "ro": "alu koto taka keji?", "en": "How much is a kilo of potatoes?", "fr": "Combien le kilo de pommes de terre ?" },
        { "bn": "এক কেজি আলু দিন।", "ro": "ek keji alu din.", "en": "A kilo of potatoes, please.", "fr": "Un kilo de pommes de terre, s'il vous plaît." },

        { "bn": "দু কেজি পেঁয়াজ দিন।", "ro": "du keji pẽyaj din.", "en": "Two kilos of onions, please.", "fr": "Deux kilos d'oignons, s'il vous plaît." },
        { "bn": "পেঁয়াজ কত টাকা কেজি?", "ro": "pẽyaj koto taka keji?", "en": "How much is a kilo of onions?", "fr": "Combien le kilo d'oignons ?" },
        { "bn": "আধ কেজি টমেটো দিন।", "ro": "adh keji tometo din.", "en": "Half a kilo of tomatoes, please.", "fr": "Un demi-kilo de tomates, s'il vous plaît." },
        { "bn": "টমেটোর দাম কত?", "ro": "tometor dam koto?", "en": "How much are the tomatoes?", "fr": "Combien coûtent les tomates ?" },
        { "bn": "আধ কেজি নেব।", "ro": "adh keji nebo.", "en": "I'll take half a kilo.", "fr": "J'en prendrai un demi-kilo." },
        { "bn": "এটা নেব।", "ro": "eta nebo.", "en": "I'll take this.", "fr": "Je prends ça." },
        { "bn": "কটা নেবে?", "ro": "kota nebe?", "en": "How many will you take?", "fr": "Tu en prends combien ?" },

        { "bn": "ফল খাবেন?", "ro": "fol khaben?", "en": "Will you have some fruit?", "fr": "Vous prendrez un fruit ?" },
        { "bn": "আপনি কি ফল খান?", "ro": "apni ki fol khan?", "en": "Do you eat fruit?", "fr": "Vous mangez des fruits ?" },
        { "bn": "আমের দাম কত?", "ro": "amer dam koto?", "en": "How much are the mangoes?", "fr": "Combien coûtent les mangues ?" },
        { "bn": "এক কেজি আম দেবেন?", "ro": "ek keji am deben?", "en": "Could you give me a kilo of mangoes?", "fr": "Vous me donnez un kilo de mangues ?" },
        { "bn": "ছটা কলা দিন।", "ro": "chhota kola din.", "en": "Six bananas, please.", "fr": "Six bananes, s'il vous plaît." },
        { "bn": "আমাকে দুটো কলা দেবেন?", "ro": "amake duto kola deben?", "en": "Could you give me two bananas?", "fr": "Vous pourriez me donner deux bananes ?" },

        { "bn": "দাম খুব বেশি।", "ro": "dam khub beshi.", "en": "The price is too high.", "fr": "C'est trop cher." },
        { "bn": "একটু কম হবে?", "ro": "ektu kom hobe?", "en": "Can you make it a bit less?", "fr": "Vous pouvez baisser un peu ?" },
        { "bn": "ভাড়া খুব বেশি।", "ro": "bhara khub beshi.", "en": "The fare is too high.", "fr": "La course est trop chère." },
        { "bn": "আলুর দাম কম।", "ro": "alur dam kom.", "en": "Potatoes are cheap.", "fr": "Les pommes de terre ne sont pas chères." },
        { "bn": "একটু কম দিন।", "ro": "ektu kom din.", "en": "Give me a little less, please.", "fr": "Donnez-m'en un peu moins, s'il vous plaît." },
