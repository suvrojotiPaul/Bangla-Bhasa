        "বাজে": { "ro": "baje", "en": "O'clock (it strikes)", "fr": "Heure(s) (il est…)", "pos": "verb", "note": "কটা বাজে? = What time is it? এখন তিনটে বাজে = It's three o'clock now. The hour takes its counter: তিনটে, পাঁচটা." },
        "সময়": { "ro": "shomoy", "en": "Time", "fr": "Temps", "pos": "noun" },
        "ঘণ্টা": { "ro": "ghonta", "en": "Hour", "fr": "Heure (durée)", "pos": "noun" },
        "সাড়ে": { "ro": "sare", "en": "Half past", "fr": "Et demie", "pos": "adj", "note": "সাড়ে তিনটে = half past three. Half past one and half past two have their own words: দেড়টা, আড়াইটে." },
        "সোয়া": { "ro": "shoya", "en": "Quarter past", "fr": "Et quart", "pos": "adj" },
        "পৌনে": { "ro": "poune", "en": "Quarter to", "fr": "Moins le quart", "pos": "adj", "note": "পৌনে আটটা = quarter to eight." },
        "মিনিট": { "ro": "minit", "en": "Minute", "fr": "Minute", "pos": "noun" },
        "সকাল": { "ro": "shokal", "en": "Morning", "fr": "Matin", "pos": "noun", "note": "সকালে = in the morning. The same -এ works for দুপুরে, বিকেলে, রাতে." },
        "দুপুর": { "ro": "dupur", "en": "Midday, early afternoon", "fr": "Midi, début d'après-midi", "pos": "noun", "note": "Roughly 12 to 3, lunchtime." },
        "বিকেল": { "ro": "bikel", "en": "Late afternoon", "fr": "Fin d'après-midi", "pos": "noun", "note": "Roughly 3 to 6: the time for tea." },
        "সন্ধ্যা": { "ro": "shondha", "en": "Evening", "fr": "Soir", "pos": "noun", "note": "Often written সন্ধে, the way it's said." },
        "রাত": { "ro": "rat", "en": "Night", "fr": "Nuit", "pos": "noun" },
