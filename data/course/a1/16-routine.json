      "title": "My day",
      "titleBn": "আমার দিন",
      "subtitle": "I get up, bathe, work, come home",
      "words": {
        "রোজ": { "ro": "roj", "en": "Every day", "fr": "Tous les jours", "pos": "adv" },
        "উঠি": { "ro": "uthi", "en": "(I) get up", "fr": "(Je) me lève", "pos": "verb" },
        "করি": { "ro": "kori", "en": "(I) do", "fr": "(Je) fais", "pos": "verb", "note": "Many Bengali verbs are a noun + করা: স্নান করি (bathe), রান্না করি (cook), কাজ করি (work)." },
        "স্নান": { "ro": "snan", "en": "Bath, bathing", "fr": "Bain, toilette", "pos": "noun", "note": "স্নান করি = I have a bath (usually a bucket bath)." },
        "করো": { "ro": "koro", "en": "(You, friendly) do", "fr": "(Tu) fais", "pos": "verb", "note": "Also the friendly command: বন্ধ করো = close (it)." },
        "করেন": { "ro": "koren", "en": "(You, polite) do", "fr": "(Vous) faites", "pos": "verb" },
        "কাজ": { "ro": "kaj", "en": "Work, job; task", "fr": "Travail ; tâche", "pos": "noun", "note": "কাজ করি = I work." },
        "রান্না": { "ro": "ranna", "en": "Cooking", "fr": "Cuisine (le fait de cuisiner)", "pos": "noun", "note": "রান্না করি = I cook." },
        "করে": { "ro": "kore", "en": "(He, she) does", "fr": "(Il, elle) fait", "pos": "verb" },
        "ফিরি": { "ro": "firi", "en": "(I) come back, return", "fr": "(Je) rentre, reviens", "pos": "verb" },
        "তারপর": { "ro": "tarpor", "en": "Then, after that", "fr": "Ensuite, puis", "pos": "adv" },
        "প্রথমে": { "ro": "prothome", "en": "First, at first", "fr": "D'abord", "pos": "adv" },
        "ঘুমোই": { "ro": "ghumoi", "en": "(I) sleep", "fr": "(Je) dors", "pos": "verb", "forms": {
          "ঘুমোও": { "ro": "ghumoo", "en": "(You, friendly) sleep", "fr": "(Tu) dors" }
        } },
        "পড়ি": { "ro": "pori", "en": "(I) read, study", "fr": "(Je) lis, étudie", "pos": "verb", "forms": {
          "পড়ো": { "ro": "poro", "en": "(You, friendly) read, study", "fr": "(Tu) lis, étudies" },
