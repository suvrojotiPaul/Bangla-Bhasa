        } }
      },
      "lessons": [
        ["রোজ", "উঠি", "করি", "স্নান"],
        ["করো", "করেন", "কাজ", "রান্না"],
        ["করে", "ফিরি", "তারপর", "প্রথমে"],
        ["ঘুমোই", "পড়ি"]
      ],
      "sentences": [
        { "bn": "আমি রোজ সাতটায় উঠি।", "ro": "ami roj sattay uthi.", "en": "I get up at seven every day.", "fr": "Je me lève à sept heures tous les jours." },
        { "bn": "আমি ছটায় উঠি।", "ro": "ami chhotay uthi.", "en": "I get up at six.", "fr": "Je me lève à six heures." },
        { "bn": "আমি রোজ চা খাই।", "ro": "ami roj cha khai.", "en": "I drink tea every day.", "fr": "Je bois du thé tous les jours." },
        { "bn": "সকালে স্নান করি।", "ro": "shokale snan kori.", "en": "I bathe in the morning.", "fr": "Je fais ma toilette le matin." },
        { "bn": "রোজ সকালে স্নান করি।", "ro": "roj shokale snan kori.", "en": "I bathe every morning.", "fr": "Je fais ma toilette tous les matins." },
        { "bn": "আমি কাজ করি না।", "ro": "ami kaj kori na.", "en": "I don't work.", "fr": "Je ne travaille pas." },

        { "bn": "তুমি কী করো?", "ro": "tumi ki koro?", "en": "What do you do?", "fr": "Qu'est-ce que tu fais ?" },
        { "bn": "আপনি কী কাজ করেন?", "ro": "apni ki kaj koren?", "en": "What work do you do?", "fr": "Quel travail faites-vous ?" },
        { "bn": "আমি অফিসে কাজ করি।", "ro": "ami ofishe kaj kori.", "en": "I work in an office.", "fr": "Je travaille dans un bureau." },
        { "bn": "তুমি রান্না করো?", "ro": "tumi ranna koro?", "en": "Do you cook?", "fr": "Tu cuisines ?" },
        { "bn": "মা রান্না করেন।", "ro": "ma ranna koren.", "en": "Mum cooks.", "fr": "Maman fait la cuisine." },
        { "bn": "আমি রোজ রান্না করি।", "ro": "ami roj ranna kori.", "en": "I cook every day.", "fr": "Je cuisine tous les jours." },
        { "bn": "আপনি কি রান্না করেন?", "ro": "apni ki ranna koren?", "en": "Do you cook?", "fr": "Vous cuisinez ?" },

        { "bn": "ও কী কাজ করে?", "ro": "o ki kaj kore?", "en": "What work does he do?", "fr": "Quel travail fait-il ?" },
        { "bn": "রিয়া রোজ রান্না করে।", "ro": "riya roj ranna kore.", "en": "Riya cooks every day.", "fr": "Riya cuisine tous les jours." },
        { "bn": "আমি সাতটায় বাড়ি ফিরি।", "ro": "ami sattay bari firi.", "en": "I get home at seven.", "fr": "Je rentre à la maison à sept heures." },
        { "bn": "সন্ধ্যায় বাড়ি ফিরি।", "ro": "shondhay bari firi.", "en": "I come home in the evening.", "fr": "Je rentre le soir." },
        { "bn": "প্রথমে চা খাই, তারপর স্নান করি।", "ro": "prothome cha khai, tarpor snan kori.", "en": "First I have tea, then I bathe.", "fr": "D'abord je bois du thé, puis je fais ma toilette." },
        { "bn": "তারপর অফিস যাই।", "ro": "tarpor ofish jai.", "en": "Then I go to the office.", "fr": "Ensuite je vais au bureau." },
        { "bn": "প্রথমে স্নান করি।", "ro": "prothome snan kori.", "en": "First I bathe.", "fr": "D'abord je fais ma toilette." },

        { "bn": "আমি এগারোটায় ঘুমোই।", "ro": "ami egarotay ghumoi.", "en": "I go to sleep at eleven.", "fr": "Je me couche à onze heures." },
        { "bn": "রাত বারোটায় ঘুমোই।", "ro": "rat barotay ghumoi.", "en": "I sleep at midnight.", "fr": "Je me couche à minuit." },
        { "bn": "তুমি কটায় ঘুমোও?", "ro": "tumi kotay ghumoo?", "en": "What time do you go to sleep?", "fr": "Tu te couches à quelle heure ?" },
        { "bn": "রাতে বই পড়ি।", "ro": "rate boi pori.", "en": "I read a book at night.", "fr": "Le soir, je lis un livre." },
        { "bn": "আমি বাংলা পড়ি।", "ro": "ami bangla pori.", "en": "I study Bengali.", "fr": "J'étudie le bengali." },
        { "bn": "তুমি কী পড়ো?", "ro": "tumi ki poro?", "en": "What do you study?", "fr": "Qu'est-ce que tu étudies ?" },
        { "bn": "ভাই রোজ বই পড়ে।", "ro": "bhai roj boi pore.", "en": "My brother reads every day.", "fr": "Mon frère lit tous les jours." }
      ]
    }
  ]
}
