      "sentences": [
        { "bn": "আমার গান ভালো লাগে।", "ro": "amar gan bhalo lage.", "en": "I like music.", "fr": "J'aime la musique." },
        { "bn": "তোমার কী ভালো লাগে?", "ro": "tomar ki bhalo lage?", "en": "What do you like?", "fr": "Qu'est-ce que tu aimes ?" },
