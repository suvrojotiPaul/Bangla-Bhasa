        { "bn": "আমার ক্রিকেট খেলা ভালো লাগে।", "ro": "amar kriket khela bhalo lage.", "en": "I like cricket.", "fr": "J'aime le cricket." },
        { "bn": "রবিবার ফুটবল খেলা দেখি।", "ro": "robibar futbol khela dekhi.", "en": "On Sundays I watch football.", "fr": "Le dimanche, je regarde le football." },
        { "bn": "আজ খেলা আছে।", "ro": "aj khela achhe.", "en": "There's a match today.", "fr": "Il y a un match aujourd'hui." },
