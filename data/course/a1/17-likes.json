        { "bn": "আমার বাংলা সিনেমা পছন্দ।", "ro": "amar bangla shinema pochhondo.", "en": "I like Bengali films.", "fr": "J'aime les films bengalis." },
        { "bn": "শনিবার সিনেমা দেখি।", "ro": "shonibar shinema dekhi.", "en": "I watch a film on Saturdays.", "fr": "Le samedi, je regarde un film." },
        { "bn": "আমি রাতে সিনেমা দেখি।", "ro": "ami rate shinema dekhi.", "en": "I watch films at night.", "fr": "Le soir, je regarde des films." },

