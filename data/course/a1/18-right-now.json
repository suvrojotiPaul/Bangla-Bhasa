      "sentences": [
        { "bn": "কী করছ?", "ro": "ki korchho?", "en": "What are you doing?", "fr": "Qu'est-ce que tu fais ?" },
        { "bn": "তুমি কী করছ?", "ro": "tumi ki korchho?", "en": "What are you doing?", "fr": "Qu'est-ce que tu fais ?" },
        { "bn": "আমি রান্না করছি।", "ro": "ami ranna korchhi.", "en": "I'm cooking.", "fr": "Je fais la cuisine." },
        { "bn": "কাজ করছি।", "ro": "kaj korchhi.", "en": "I'm working.", "fr": "Je travaille." },
        { "bn": "আপনি কী করছেন?", "ro": "apni ki korchhen?", "en": "What are you doing?", "fr": "Que faites-vous ?" },
        { "bn": "উনি কাজ করছেন।", "ro": "uni kaj korchhen.", "en": "He's working.", "fr": "Il travaille." },
        { "bn": "ও কী করছে?", "ro": "o ki korchhe?", "en": "What is she doing?", "fr": "Qu'est-ce qu'elle fait ?" },
        { "bn": "রিয়া রান্না করছে।", "ro": "riya ranna korchhe.", "en": "Riya is cooking.", "fr": "Riya fait la cuisine." },

        { "bn": "অফিস যাচ্ছি।", "ro": "ofish jachchhi.", "en": "I'm going to the office.", "fr": "Je vais au bureau." },
        { "bn": "আমি বাজারে যাচ্ছি।", "ro": "ami bajare jachchhi.", "en": "I'm going to the market.", "fr": "Je vais au marché." },
        { "bn": "কোথায় যাচ্ছ?", "ro": "kothay jachchho?", "en": "Where are you going?", "fr": "Où vas-tu ?" },
        { "bn": "তুমি কি বাড়ি যাচ্ছ?", "ro": "tumi ki bari jachchho?", "en": "Are you going home?", "fr": "Tu rentres à la maison ?" },
        { "bn": "আমি আসছি।", "ro": "ami aschhi.", "en": "I'm coming.", "fr": "J'arrive." },
        { "bn": "এখনই আসছি।", "ro": "ekhoni aschhi.", "en": "I'm coming right now.", "fr": "J'arrive tout de suite." },
        { "bn": "এখনই যাচ্ছি।", "ro": "ekhoni jachchhi.", "en": "I'm going right now.", "fr": "J'y vais tout de suite." },

        { "bn": "আমি ভাত খাচ্ছি।", "ro": "ami bhat khachchhi.", "en": "I'm eating rice.", "fr": "Je mange du riz." },
        { "bn": "চা খাচ্ছি।", "ro": "cha khachchhi.", "en": "I'm having tea.", "fr": "Je bois du thé." },
        { "bn": "আমি সিনেমা দেখছি।", "ro": "ami shinema dekhchhi.", "en": "I'm watching a film.", "fr": "Je regarde un film." },
        { "bn": "আমরা খেলা দেখছি।", "ro": "amra khela dekhchhi.", "en": "We're watching the match.", "fr": "Nous regardons le match." },
        { "bn": "আমি বই পড়ছি।", "ro": "ami boi porchhi.", "en": "I'm reading a book.", "fr": "Je lis un livre." },
        { "bn": "বাংলা পড়ছি।", "ro": "bangla porchhi.", "en": "I'm studying Bengali.", "fr": "J'étudie le bengali." },
        { "bn": "গান শুনছি।", "ro": "gan shunchhi.", "en": "I'm listening to music.", "fr": "J'écoute de la musique." },
        { "bn": "হ্যাঁ, শুনছি।", "ro": "hyã, shunchhi.", "en": "Yes, I'm listening.", "fr": "Oui, j'écoute." },

        { "bn": "আমি অপেক্ষা করছি।", "ro": "ami opekkha korchhi.", "en": "I'm waiting.", "fr": "J'attends." },
        { "bn": "একটু অপেক্ষা করুন।", "ro": "ektu opekkha korun.", "en": "Please wait a moment.", "fr": "Attendez un instant, s'il vous plaît." },
        { "bn": "একটু তাড়াতাড়ি করুন।", "ro": "ektu taratari korun.", "en": "Please hurry up a little.", "fr": "Dépêchez-vous un peu, s'il vous plaît." },
        { "bn": "আমি স্টেশনে অপেক্ষা করছি।", "ro": "ami steshone opekkha korchhi.", "en": "I'm waiting at the station.", "fr": "J'attends à la gare." },
        { "bn": "এখানে বসুন।", "ro": "ekhane boshun.", "en": "Please sit here.", "fr": "Asseyez-vous ici." },
        { "bn": "একটু বসুন।", "ro": "ektu boshun.", "en": "Please sit for a moment.", "fr": "Asseyez-vous un instant." },
        { "bn": "শুনুন, দাদা!", "ro": "shunun, dada!", "en": "Excuse me!", "fr": "Excusez-moi, monsieur !" },
        { "bn": "একটু শুনুন।", "ro": "ektu shunun.", "en": "Excuse me a moment.", "fr": "Écoutez-moi un instant." }
      ]
    }
