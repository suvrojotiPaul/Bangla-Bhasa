      "subtitle": "Excuse me, no problem, welcome, happy birthday",
      "words": {
        "মাফ": { "ro": "maf", "en": "Pardon, forgiveness", "fr": "Pardon", "pos": "noun", "note": "মাফ করবেন = Excuse me / I'm sorry (polite)." },
        "মনে": { "ro": "mone", "en": "In mind", "fr": "En tête, à l'esprit", "pos": "noun", "note": "মনে আছে = (I) remember; কিছু মনে করবেন না = please don't mind." },
        "ভুল": { "ro": "bhul", "en": "Mistake; wrong", "fr": "Erreur ; faux", "pos": "noun" },
        "সরি": { "ro": "sori", "en": "Sorry (everyday)", "fr": "Pardon (courant)", "pos": "intj", "note": "From English, and used all the time. দুঃখিত is more formal." },
        "কোনো": { "ro": "kono", "en": "Any", "fr": "Aucun, quelque", "pos": "det", "note": "Not the same as কোন (which): কোনো অসুবিধা নেই = there's no problem at all." },
        "ব্যাপার": { "ro": "byapar", "en": "Matter, thing", "fr": "Affaire, chose", "pos": "noun", "note": "কী ব্যাপার? = What's up? What's the matter?" },
        "অসুবিধা": { "ro": "oshubidha", "en": "Problem, trouble", "fr": "Problème, gêne", "pos": "noun" },
        "আসুন": { "ro": "ashun", "en": "Please come (in)", "fr": "Entrez, venez", "pos": "verb" },
        "এসো": { "ro": "esho", "en": "Come (friendly)", "fr": "Viens", "pos": "verb" },
        "বসো": { "ro": "bosho", "en": "Sit (friendly)", "fr": "Assieds-toi", "pos": "verb" },
        "স্বাগত": { "ro": "shagoto", "en": "Welcome", "fr": "Bienvenue", "pos": "intj" },
        "শুভ": { "ro": "shubho", "en": "Happy (in wishes)", "fr": "Joyeux, heureux (vœux)", "pos": "adj" },
        "জন্মদিন": { "ro": "jonmodin", "en": "Birthday", "fr": "Anniversaire", "pos": "noun" },
